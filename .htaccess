# Apache configuration for the Dutch Cloud Solutions static site.
# Ignored by IIS (which uses web.config). Every block is optional and guarded.

DirectoryIndex index.html

# Never serve repository internals or documentation when the repo is pulled into the web root
RedirectMatch 404 /\.git
RedirectMatch 404 /\.github
RedirectMatch 404 ^/docs(/|$)
RedirectMatch 404 \.md$

AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(woff2|mp4|jpg|png|svg|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/manifest+json
</IfModule>
